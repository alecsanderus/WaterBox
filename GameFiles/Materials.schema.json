{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Material schema",
  "type": "object",
  "required": [ "Materials" ],
  "properties": {
    "Materials": {
      "type": "array",
      "description": "array of materials",
      "items": {
        "type": "object",
        "required": [
          "name",
          "can_be_shown",
          "keep_color_proportions",
          "category_key",
          "state_category",
          "initial_temperature",
          "density",
          "thermal_conductivity",
          "specific_heat_capacity",
          "color_Max_R",
          "color_Max_G",
          "color_Max_B",
          "color_Min_R",
          "color_Min_G",
          "color_Min_B"
        ],
        "unevaluatedProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "Material name, its ID"
          },
          "can_be_shown": {
            "type": "boolean",
            "description": "Must show this material in the material table"
          },
          "category_key": {
            "type": "string",
            "description": "Materials category"
          },
          "state_category": {
            "$ref": "#/$defs/stateCategory",
            "description": "Aggregative state of the material"
          },
          "initial_temperature": {
            "type": "number",
            "minimum": -273.15,
            "description": "Initial temperature in Celsius degrees"
          },
          "density": {
            "type": "number",
            "minimum": 0,
            "description": "Material density in kg/m3"
          },
          "thermal_conductivity": {
            "type": "number",
            "minimum": 0,
            "description": "Thermal conductivity in W/(m*K)"
          },
          "specific_heat_capacity": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Specific heat capacity in J/(kg*K)"
          },
          "bounciness": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "Coefficient of restitution (bounciness) for vertical bounce"
          },
          "catter_factor": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "Factor of vertical energy converted into horizontal velocity (scattering) upon collision"
          },
          "surface_friction": {
            "type": "number",
            "minimum": 0.0,
            "description": "Force subtracted from horizontal velocity (VelX)"
          },
          "can_slide": {
            "type": "boolean",
            "description": "Must the material slide like a sand, only for solids"
          },
          "show_priority": {
            "type": "integer",
            "description": "Display priority in the materials table"
          },
          "keep_color_proportions": {
            "type": "boolean",
            "description": "Keep RGB proportions when selecting a random color"
          },
          "color_Max_R": {
            "$ref": "#/$defs/colorComponent",
            "description": "Color"
          },
          "color_Max_G": {
            "$ref": "#/$defs/colorComponent",
            "description": "Color"
          },
          "color_Max_B": {
            "$ref": "#/$defs/colorComponent",
            "description": "Color"
          },
          "color_Min_R": {
            "$ref": "#/$defs/colorComponent",
            "description": "Color"
          },
          "color_Min_G": {
            "$ref": "#/$defs/colorComponent",
            "description": "Color"
          },
          "color_Min_B": {
            "$ref": "#/$defs/colorComponent",
            "description": "Color"
          }
        }
      }
    },

    "Categories": {
      "type": "array",
      "description": "array of categories",
      "items": {
        "type": "object",
        "required": [
          "name",
          "can_be_shown",
          "color_R",
          "color_G",
          "color_B"
        ],
        "unevaluatedProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "Category name, its ID"
          },
          "can_be_shown": {
            "type": "boolean",
            "description": "Must show this category in the material table"
          },
          "show_priority": {
            "type": "integer",
            "description": "Display priority in the materials table"
          },
          "color_R": {
            "$ref": "#/$defs/colorComponent",
            "description": "Color"
          },
          "color_G": {
            "$ref": "#/$defs/colorComponent",
            "description": "Color"
          },
          "color_B": {
            "$ref": "#/$defs/colorComponent",
            "description": "Color"
          }
        }
      }
    }
  },
  "$defs": {
    "colorComponent": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "stateCategory": {
      "type": "string",
      "enum": ["static", "solid", "liquid", "gas" ]
    }
  }
}